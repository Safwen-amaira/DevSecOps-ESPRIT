# Optional local overrides. Compose has local-only defaults for a zero-config demo.
# Change these before exposing any service beyond 127.0.0.1.
DB_NAME=timesheet-devops-db
DB_PASSWORD=local-only-timesheet-password
SONAR_DB_PASSWORD=local-only-sonar-password
GRAFANA_ADMIN_PASSWORD=local-only-grafana-password
JENKINS_ADMIN_ID=safwen
JENKINS_ADMIN_PASSWORD=local-only-jenkins-password
# Set to the host Docker socket's group id (Linux: stat -c '%g' /var/run/docker.sock)
DOCKER_GID=999
# Optional Slack incoming webhook; keep the real URL only in untracked .env / CI secrets.
SLACK_WEBHOOK_URL=
