pipeline {
  agent any
  triggers { cron('H/5 * * * *') }
  options { timestamps(); disableConcurrentBuilds(); buildDiscarder(logRotator(numToKeepStr: '20')) }
  environment {
    REPOSITORY = 'https://github.com/Safwen-amaira/DevSecOps-ESPRIT.git'
    GITHUB_API = 'https://api.github.com/repos/Safwen-amaira/DevSecOps-ESPRIT/actions/runs'
    K8S_NAMESPACE = 'timesheet'
    IMAGE = "timesheet:${BUILD_NUMBER}"
    APP_URL = 'http://k3s:30082/timesheet-devops/actuator/health'
  }
  stages {
    stage('Checkout candidate') {
      steps {
        checkout([$class: 'GitSCM', branches: [[name: '*/master']], userRemoteConfigs: [[url: env.REPOSITORY]], extensions: [[$class: 'CleanBeforeCheckout']]])
        script { env.CANDIDATE_SHA = sh(script: 'git rev-parse HEAD', returnStdout: true).trim() }
      }
    }
    stage('Require successful GitHub security workflow') {
      steps {
        script {
          timeout(time: 15, unit: 'MINUTES') {
            waitUntil(initialRecurrencePeriod: 15000) {
              def raw = sh(script: "curl -fsS '${env.GITHUB_API}?head_sha=${env.CANDIDATE_SHA}&per_page=20'", returnStdout: true)
              def runs = readJSON text: raw
              def run = runs.workflow_runs.find { it.name == 'DevSecOps' && it.event == 'push' && it.head_sha == env.CANDIDATE_SHA }

              if (!run) {
                echo "Waiting for a GitHub Actions push run for ${env.CANDIDATE_SHA}."
                return false
              }

              echo "GitHub Actions run ${run.html_url}: status=${run.status}, conclusion=${run.conclusion ?: 'pending'}"
              if (run.status != 'completed') {
                return false
              }
              if (run.conclusion != 'success') {
                error("GitHub DevSecOps checks finished with '${run.conclusion}' for ${env.CANDIDATE_SHA}; deployment is gated.")
              }
              return true
            }
          }
        }
      }
    }
    stage('Pre-deploy security gates') {
      steps {
        sh '''
          mkdir -p reports
          gitleaks git --redact --no-banner .
          semgrep scan --config security/semgrep-rules.yml --severity ERROR --error --json --output reports/semgrep-jenkins.json .
          mvn --batch-mode --no-transfer-progress package
          trivy fs --scanners vuln --severity CRITICAL --ignore-unfixed --exit-code 1 --format json --output reports/trivy-dependencies.json .
          trivy config --severity CRITICAL --exit-code 1 .
          docker build --tag "$IMAGE" .
          trivy image --scanners vuln --timeout 20m --severity CRITICAL --ignore-unfixed --exit-code 1 "$IMAGE"
        '''
      }
    }
    stage('Deploy to local Kubernetes (k3s)') {
      steps {
        sh '''
          kubectl apply -f kubernetes/database/pvc.yaml
          kubectl create secret generic timesheet-db -n "$K8S_NAMESPACE" \\
            --from-literal=password="$DB_PASSWORD" --dry-run=client -o yaml | kubectl apply -f -
          kubectl apply -f kubernetes/database/deployment.yaml
          kubectl apply -f kubernetes/database/service.yaml
          kubectl apply -f kubernetes/app/deployment.yaml
          kubectl apply -f kubernetes/app/service.yaml
          docker save "$IMAGE" | docker exec -i k3s ctr -n k8s.io images import -
          kubectl set image deployment/timesheet-dep timesheet="$IMAGE" -n "$K8S_NAMESPACE"
          kubectl rollout status deployment/mysql-dep -n "$K8S_NAMESPACE" --timeout=180s
          kubectl rollout status deployment/timesheet-dep -n "$K8S_NAMESPACE" --timeout=240s
          for attempt in $(seq 1 30); do curl -fsS "$APP_URL" && exit 0; sleep 3; done
          echo 'Kubernetes application health check failed'; exit 1
        '''
      }
    }
    stage('DAST on deployed service') {
      steps {
        sh '''
          docker run --rm --network devsecops -v "$WORKSPACE/reports:/zap/wrk:rw" ghcr.io/zaproxy/zaproxy:stable \
            zap-baseline.py -t http://k3s:30082/timesheet-devops/ -m 3 -I -J zap-report.json -r zap-report.html
        '''
      }
    }
  }
  post {
    always {
      archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
      script {
        def success = currentBuild.currentResult == 'SUCCESS' ? 1 : 0
        sh """curl -fsS -H 'Content-Type: text/plain' --data-binary 'devsecops_jenkins_build_info{job=\"${env.JOB_NAME}\",build=\"${env.BUILD_NUMBER}\",commit=\"${env.CANDIDATE_SHA ?: 'unknown'}\"} 1\ndevsecops_jenkins_build_success ${success}\n' http://pushgateway:9091/metrics/job/jenkins/instance/local || true"""
      }
    }
    failure {
      sh '''
        if [ -n "$SLACK_WEBHOOK_URL" ]; then
          python3 -c 'import json,os; print(json.dumps({"text": "DevSecOps pipeline FAILED: " + os.getenv("BUILD_URL", "") + " (" + os.getenv("CANDIDATE_SHA", "unknown") + ")"}))' \
            | curl -fsS -H 'Content-Type: application/json' --data-binary @- "$SLACK_WEBHOOK_URL"
        fi
      '''
    }
  }
}
